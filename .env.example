# Local development settings for foundry-console. Copy to .env and fill in; .env is
# git-ignored and never committed. In a cluster these come from the chart's config and
# Secrets, not from this file.

# The GitHub organization the console acts under (canonical case).
FC_ORG=
# The operator admitted on loopback when OIDC is off (local development only).
FC_LOCAL_OPERATOR=
# Activate the in-cluster stores (leave empty locally).
FC_LIVE=
