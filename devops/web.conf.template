map $remote_addr $console_user {
    default "";
    127.0.0.1 $http_x_forwarded_user;
    ::1 $http_x_forwarded_user;
}
map $remote_addr $console_email {
    default "";
    127.0.0.1 $http_x_forwarded_email;
    ::1 $http_x_forwarded_email;
}
map $remote_addr $console_groups {
    default "";
    127.0.0.1 $http_x_forwarded_groups;
    ::1 $http_x_forwarded_groups;
}
server {
    listen ${CONSOLE_BIND}:8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location = /web-health { return 200 "ok\n"; }
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_pass_request_headers off;
        proxy_set_header Accept $http_accept;
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Idempotency-Key $http_idempotency_key;
        proxy_set_header If-Match $http_if_match;
        proxy_set_header Host $host;
        proxy_set_header X-Console-Client-IP $remote_addr;
        proxy_set_header X-Console-Proxy-Secret "${CONSOLE_PROXY_SECRET}";
        proxy_set_header X-Auth-Request-User $console_user;
        proxy_set_header X-Auth-Request-Email $console_email;
        proxy_set_header X-Auth-Request-Groups $console_groups;
        proxy_set_header X-Forwarded-User "";
        proxy_set_header X-Forwarded-Email "";
        proxy_set_header X-Forwarded-Groups "";
        proxy_set_header Authorization "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;
    }
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
# The execution door (INT-FC-R173): an in-cluster listener for one configured machine caller,
# published by its own ClusterIP Service and never by the Gateway. It serves the
# delivery-execution operations alone, forwards the caller's bearer for the backend to check,
# and never forwards an operator identity. Anything else answers 404.
server {
    listen ${CONSOLE_BIND}:8081;
    server_name _;

    location ~ ^/api/(establish|agents|agents/[^/]+/apply-delivery|deliveries/(config|timeout|drive|state|close)|runs/status)$ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_pass_request_headers off;
        proxy_set_header Accept $http_accept;
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Idempotency-Key $http_idempotency_key;
        proxy_set_header If-Match $http_if_match;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
        proxy_set_header X-Console-Client-IP $remote_addr;
        proxy_set_header X-Console-Proxy-Secret "${CONSOLE_PROXY_SECRET}";
        proxy_set_header X-Console-Door execution;
        proxy_connect_timeout 5s;
        # An establish answers within a minute (it creates the repository in the request).
        proxy_read_timeout 75s;
    }
    location / { return 404; }
}
